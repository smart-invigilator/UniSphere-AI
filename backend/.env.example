# Application security
# SECRET_KEY=

# # PostgreSQL database
# DATABASE_URL=

# # CORS configuration
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# # Behavior AI (face mesh / gaze / head pose / objects)
# ENABLE_AI=true
# OBJECT_MODEL_PATH=models/yolov8s.onnx
# FRAME_SAMPLE_RATE=3

# # Identity AI (ArcFace re-verification)
# ENABLE_FACE_ID=true
# FACE_MODEL_PATH=models/arcface.onnx
# FACE_MATCH_THRESHOLD=0.38
# FACE_CHECK_EVERY=5
# FACE_MISMATCH_STREAK=3

SECRET_KEY=change-me-run-openssl-rand-hex-32

# PostgreSQL is the supported database for this system.
# Local (no Docker): postgresql+psycopg2://proctor:proctor@localhost:5432/proctor
# Docker Compose:     postgresql+psycopg2://proctor:proctor@db:5432/proctor
DATABASE_URL=postgresql+psycopg2://proctor:proctor@localhost:5432/proctor

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Behavior AI (face mesh / gaze / head pose / objects)
ENABLE_AI=true
OBJECT_MODEL_PATH=models/yolov8n.onnx
FRAME_SAMPLE_RATE=3

# Identity AI (ArcFace re-verification - see README "Enabling identity re-ID")
ENABLE_FACE_ID=true
FACE_MODEL_PATH=models/arcface.onnx
FACE_MATCH_THRESHOLD=0.38
FACE_CHECK_EVERY=5
FACE_MISMATCH_STREAK=3

# ---- Live Classes (LiveKit media server) ----
# Browser-facing URL of your LiveKit server (wss:// in production)
LIVEKIT_URL=ws://localhost:7880
# Optional: server-to-server URL if different from LIVEKIT_URL (e.g. http://livekit:7880 inside Docker)
LIVEKIT_API_URL=
# Must match the key/secret in your livekit.yaml. Keep the secret out of the frontend.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVE_TOKEN_TTL_SECONDS=900
LIVE_MAX_PARTICIPANTS=100
LIVE_ROOM_EMPTY_TIMEOUT_SECONDS=600
LIVE_ROOM_DEPARTURE_TIMEOUT_SECONDS=120
LIVE_ATTENDANCE_MIN_SECONDS=60
